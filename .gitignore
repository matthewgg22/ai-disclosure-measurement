# --- Public, aggregate-only figure inputs (exact allowlist) ---
# data/ is ignored above; re-include ONLY these per-year aggregate CSVs so the
# README figures are reproducible from committed data. Every file here is
# verified issuer-free by scripts/check_public_safe.py before commit.
# Never broaden this to a directory glob; list files by exact path.
!data/aggregates/
!data/aggregates/ai_prevalence.csv
!data/aggregates/ai_buckets_by_year.csv
!data/aggregates/ai_sector_by_year.csv
!data/aggregates/informativeness.csv
!data/aggregates/placebo_terms.csv
!data/aggregates/screen_registry.csv
!data/aggregates/validation_summary.csv
!data/aggregates/validation_lift.csv
# Revelation / event-study aggregates (F8). Population-level counts and statistics only; the
# calendar and the issuer-level CAR estimation stay in the private repo. See docs/CODEBOOK.md.
!data/aggregates/forward_vintage_summary.csv
!data/aggregates/forward_by_warning_signs.csv
!data/aggregates/revelation_calendar.csv
!data/aggregates/revelation_incidence.csv
!data/aggregates/revelation_discrimination.csv
!data/aggregates/tier_a_precision.csv
!data/aggregates/car_by_event_type.csv
!data/aggregates/attributable_loss.csv
# Multivariate model output. Coefficients are population-level parameters — they
# describe the filer population, not any issuer in it.
!data/aggregates/model_coefficients.csv
!data/aggregates/model_marginal_effects.csv
!data/aggregates/model_fit.csv
!data/aggregates/model_calibration.csv
!data/aggregates/model_calibration_fix.csv
!data/aggregates/headline_difference_in_proportions.csv
# API-202 practices: nested specifications, interactions, signed omitted-variable bias.
!data/aggregates/model_nested_specs.csv
!data/aggregates/model_nested_fit.csv
!data/aggregates/model_interactions.csv
!data/aggregates/omitted_variable_bias.csv
# Size-stratified models and the population descriptive profile (Table 1).
!data/aggregates/stratified_coefficients.csv
!data/aggregates/population_profile.csv
!data/aggregates/attributable_loss_by_stratum.csv
!data/aggregates/stratified_out_of_sample.csv
# Chain of custody: every quoted figure with the file and JSON path that produced it.
!data/aggregates/claims_ledger.csv
# Matched 7-month window: does the ordering appear early enough to act on?
!data/aggregates/forward7_vintage_summary.csv
!data/aggregates/forward7_by_warning_signs.csv
# Balance-sheet constructs: does the screen have content beyond the audit opinion?
!data/aggregates/signal_timing.csv
!data/aggregates/balance_signal_tests.csv
!data/aggregates/balance_signal_joint.csv
!data/aggregates/balance_signal_coverage.csv

